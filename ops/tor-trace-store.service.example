# Optional service: DO NOT enable until the operator configures private paths.
# Keep the same Unix account as tor-web for the private 0600 Unix socket.
# Current TOR VPS uses tor-deploy; verify deployed service user before enabling.
# The one-click release does not yet bundle tor-trace-store: install and
# verify its root-owned binary separately; NEVER enable this example as-is.
[Unit]
Description=TOR isolated diagnostic trace SQLite writer
After=local-fs.target

[Service]
Type=simple
User=tor-deploy
Group=tor-deploy
StateDirectory=tor-traces
RuntimeDirectory=tor-traces
StateDirectoryMode=0700
RuntimeDirectoryMode=0700
ExecStart=/opt/tor/current/tor-trace-store serve /var/lib/tor-traces/traces.sqlite3 /run/tor-traces/traces.sock
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/tor-traces /run/tor-traces
MemoryMax=128M
CPUQuota=25%

[Install]
WantedBy=multi-user.target
