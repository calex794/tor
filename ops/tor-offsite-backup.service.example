[Unit]
Description=TOR encrypted PostgreSQL 18 off-site backup
After=postgresql@18-main.service network-online.target
Wants=network-online.target
Requires=postgresql@18-main.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/tor-offsite-backup
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/lock
ReadOnlyPaths=/etc/tor/offsite-backup.env /etc/tor/offsite-restic-password
TimeoutStartSec=2h
