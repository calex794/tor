# TOR HOME GATEWAY: complete nginx.conf on the physical home computer.
# Listen ONLY on the WireGuard address and restrict ingress to the one peer.
# TLS ends HERE, not at the external VPS. Certs/keys never go to the VPS.
include /etc/nginx/modules-enabled/*.conf;
user www-data;
worker_processes 1;
pid @PID@;
error_log stderr warn;

events { worker_connections 1024; }

http {
    access_log off;
    server_tokens off;

    server {
        listen @LISTEN@ ssl proxy_protocol;
        server_name @DOMAIN@;
        set_real_ip_from @EDGE_IP@/32;
        real_ip_header proxy_protocol;
        ssl_certificate @CERT@;
        ssl_certificate_key @KEY@;
        ssl_protocols TLSv1.2 TLSv1.3;
        client_max_body_size 16m;

        # A valid SNI alone is not authorization to serve an arbitrary Host.
        if ($host != "@DOMAIN@") { return 421; }

        location / {
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            # Replace untrusted client-supplied forwarding headers.
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Forwarded "";
            proxy_set_header Connection "";
            proxy_connect_timeout 3s;
            proxy_read_timeout 60s;
            proxy_pass http://@BACKEND@;
        }
    }
}
