# TOR HOME GATEWAY: complete nginx.conf for the external TCP-only entrypoint.
# Generated by tools/render_home_gateway.py. Not a sites-enabled snippet.
# The external VPS NEVER terminates HTTPS or sees HTTP credentials.
include /etc/nginx/modules-enabled/*.conf;
user www-data;
worker_processes 1;
pid @PID@;
error_log stderr warn;

events { worker_connections 1024; }

stream {
    server {
        listen @LISTEN@;
        proxy_connect_timeout 3s;
        proxy_timeout 90s;
        proxy_pass @HOME_ENDPOINT@;
        # Send the actual TCP peer to the home TLS listener.
        proxy_protocol on;
    }
}
