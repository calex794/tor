# TOR / DR-02. EXAMPLE ONLY. DO NOT COPY TO A LIVE SERVER UNEDITED.
# This config is read by OS user postgres. Use a dedicated, non-public S3
# bucket and keep the REAL config outside Git, readable only by postgres.
# Secrets are intentionally absent; supply via a private file on the host.
[global]
repo1-type=s3
repo1-s3-bucket=REPLACE_WITH_DEDICATED_BACKUP_BUCKET
repo1-s3-endpoint=REPLACE_WITH_S3_ENDPOINT_HOSTNAME
repo1-s3-region=REPLACE_WITH_PROVIDER_REGION
repo1-s3-uri-style=path
repo1-s3-key-type=shared
repo1-s3-key=REPLACE_WITH_S3_BACKUP_KEY
repo1-s3-key-secret=REPLACE_WITH_S3_BACKUP_SECRET
repo1-path=/tor-postgres-18
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=REPLACE_WITH_OFFLINE_RECOVERABLE_RANDOM_PASSPHRASE
repo1-retention-full=4
repo1-retention-diff=6
start-fast=y
compress-type=zst
process-max=2

[tor]
pg1-path=/var/lib/postgresql/18/main
pg1-port=5432
pg1-socket-path=/var/run/postgresql
