# TOR: HOME ONLY. Include in the home Nginx http{} context, after wg0 is up.
# 10.88.0.2 must exist on WireGuard before Nginx starts.
# Never bind to 0.0.0.0 or the public/LAN interface.
# Rust tor-web MUST remain 127.0.0.1:3000; PostgreSQL remains localhost:5432.

server {
    listen 10.88.0.2:18081;
    server_name _;

    server_tokens off;
    access_log off;
    client_max_body_size 34m;
    client_body_timeout 30s;

    location / {
        # Even within WireGuard, accept only the known edge peer.
        allow 10.88.0.1;
        deny all;

        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host pandaolate.ru;
        proxy_set_header Connection "";

        # These headers must have been overwritten by the trusted public edge.
        # Do not use proxy_add_x_forwarded_for here.
        proxy_set_header X-Real-IP $http_x_real_ip;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Server "";
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Original-URL "";
        proxy_set_header X-Rewrite-URL "";

        proxy_connect_timeout 3s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_redirect off;
    }
}
