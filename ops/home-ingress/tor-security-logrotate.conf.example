# Example only: /etc/logrotate.d/tor-security, never auto-installed.
# This file contains visitor IP addresses; keep the directory private.
/var/log/nginx/tor-security.log {
    daily
    rotate 7
    missingok
    notifempty
    compress
    delaycompress
    create 0640 www-data adm
    sharedscripts
    postrotate
        if [ -s /run/nginx.pid ]; then
            kill -USR1 "$(cat /run/nginx.pid)" 2>/dev/null || true
        fi
    endscript
}
