# TOR: PUBLIC EDGE only. Include this file in Nginx's http{} context.
# REVIEW FIRST: it would replace an existing pandaolate.ru site on the VPS.
# TOR and PostgreSQL MUST NOT run on this VPS.
# Requires a real certificate and a functioning private WireGuard peer.
# This is NOT installed by CI, git merge, or a release workflow.

server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name pandaolate.ru;

    # Certificate issuance is a separate manual prerequisite.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        try_files $uri =404;
    }
    location / {
        return 308 https://pandaolate.ru$request_uri;
    }
}

# Reject TLS with an unknown SNI instead of proxying an unrecognized host.
server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    server_name pandaolate.ru;

    ssl_certificate /etc/letsencrypt/live/pandaolate.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pandaolate.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    ssl_session_cache shared:TOR_SSL:5m;
    ssl_session_timeout 10m;

    server_tokens off;
    access_log off;
    # 32 MiB ZIP import plus multipart overhead; the app still enforces its own limit.
    client_max_body_size 34m;
    client_header_timeout 15s;
    client_body_timeout 30s;
    keepalive_timeout 20s;
    gzip off;

    # Public edge must not expose administrative/diagnostic probes.
    location = /healthz { return 404; }
    location = /readyz { return 404; }
    location = /internal/metrics { return 404; }
    location = /metrics { return 404; }
    location ~ /\.(?!well-known/) { return 404; }

    location / {
        # Do not allow hostile Host/X-Forwarded-* values to reach TOR.
        proxy_pass http://10.88.0.2:18081;
        proxy_http_version 1.1;
        proxy_set_header Host pandaolate.ru;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Server "";
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Original-URL "";
        proxy_set_header X-Rewrite-URL "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        # Avoid storing private chapters or signed grants in cache/temp files.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_redirect off;
    }
}
