# TOR: PUBLIC EDGE only. Include this file in Nginx's http{} context.
# REVIEW FIRST: it would replace an existing pandaolate.ru site on the VPS.
# TOR and PostgreSQL MUST NOT run on this VPS.
# Requires a real certificate and a functioning private WireGuard peer.
# This is NOT installed by CI, git merge, or a release workflow.

# AB-06/12/14: public edge only; NEVER auto-installed.
# This file is included inside http{}. The direct peer is the real source.
# Do not use any client-supplied Forwarded or X-Real-IP as a rate-limit key.
# Behind a CDN, first configure and test an explicit trusted real_ip chain.
map $uri $tor_security_route {
    default other;
    ~^/(login|register)(/|$) auth;
    ~^/__bp_honeypot/ trap;
    ~^/admin(/|$) admin;
    ~^/me(/|$) account;
    ~^/(books|reader|chapters)(/|$) reading;
    ~^/(catalog|search|sitemap)(/|$) discovery;
    ~^/assets/ static;
}
# Only POST /login and POST /register consume the strict auth bucket.
# An empty map key is not counted by limit_req_zone.
map "$request_method:$uri" $tor_auth_client_key {
    default "";
    ~^POST:/(login|register)/?$ $binary_remote_addr;
}
limit_req_zone $binary_remote_addr zone=tor_public_per_ip:10m rate=6r/s;
limit_req_zone $tor_auth_client_key zone=tor_auth_per_ip:5m rate=1r/s;

# Security log: no request URI, query, UA, referrer, session, cookie or user ID.
# IP is sensitive data: strict OS permissions and 7-day retention are required.
log_format tor_security 'ts=$time_iso8601 ip=$remote_addr method=$request_method '
                        'status=$status route=$tor_security_route '
                        'limiter=$limit_req_status rt=$request_time';

# Reuse a small bounded set of TCP connections across the WireGuard tunnel.
# Without it, high request rates can exhaust the edge's ephemeral source ports.
# The home gateway still enforces its WireGuard peer allowlist on every request.
upstream tor_home_backend {
    server 10.88.0.2:18081;
    keepalive 16;
    keepalive_timeout 10s;
    keepalive_requests 1000;
}

server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name pandaolate.ru;

    # Certificate issuance is a separate manual prerequisite.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        try_files $uri =404;
    }
    location / {
        return 308 https://pandaolate.ru$request_uri;
    }
}

# Reject TLS with an unknown SNI instead of proxying an unrecognized host.
server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    server_name pandaolate.ru;

    ssl_certificate /etc/letsencrypt/live/pandaolate.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pandaolate.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    ssl_session_cache shared:TOR_SSL:5m;
    ssl_session_timeout 10m;

    server_tokens off;
    access_log /var/log/nginx/tor-security.log tor_security buffer=16k flush=1s;
    limit_req_status 429;
    # Observe first. Enforce only after false-positive, crawler and NAT tests.
    limit_req_dry_run on;
    limit_req zone=tor_public_per_ip burst=80 nodelay;
    limit_req zone=tor_auth_per_ip burst=8 nodelay;
    # 32 MiB ZIP import plus multipart overhead; the app still enforces its own limit.
    client_max_body_size 34m;
    client_header_timeout 15s;
    client_body_timeout 30s;
    keepalive_timeout 20s;
    gzip off;

    # Public edge must not expose administrative/diagnostic probes.
    location = /healthz { return 404; }
    location = /readyz { return 404; }
    location = /internal/metrics { return 404; }
    location = /metrics { return 404; }
    location ~ /\.(?!well-known/) { return 404; }
    # Cheap scanner denial, without blanket blocking legitimate .zip/.json.
    location ~* (?:^|/)(?:wp-admin|wp-content|wp-includes|wp-login\.php|xmlrpc\.php|phpmyadmin|pma|cgi-bin|vendor/phpunit)(?:/|$) {
        return 444;
    }
    location ~* \.php(?:/|$) { return 444; }

    location / {
        # Do not allow hostile Host/X-Forwarded-* values to reach TOR.
        proxy_pass http://tor_home_backend;
        proxy_http_version 1.1;
        proxy_set_header Host pandaolate.ru;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Server "";
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Original-URL "";
        proxy_set_header X-Rewrite-URL "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        # Avoid storing private chapters or signed grants in cache/temp files.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_redirect off;
    }
}
