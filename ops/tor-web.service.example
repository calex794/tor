[Unit]
Description=TOR demo Rust server (loopback behind nginx)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tor-deploy
Group=tor-deploy
WorkingDirectory=/opt/tor
Environment=TOR_DEMO_MODE=1
Environment=TOR_LISTEN_ADDR=127.0.0.1:3000
ExecStart=/opt/tor/current/tor-web
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
MemoryMax=256M
TasksMax=64
UMask=0077

[Install]
WantedBy=multi-user.target
