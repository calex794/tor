+//! Read-only current sample. GET does not launch checks or change their baseline.
+use super::{administrator, secure, AudienceState};
+use axum::{extract::State, http::{HeaderMap, StatusCode}, response::Response};
+use std::time::Duration;
+use tokio::time::{timeout_at, Instant};
+
+pub(super) async fn page(State(state): State<AudienceState>, headers: HeaderMap) -> Response {
+    let deadline = Instant::now()+Duration::from_millis(950);
+    match timeout_at(deadline, administrator(&state, &headers)).await {
+        Ok(Ok(())) => (),
+        Ok(Err(status)) => return secure(status),
+        Err(_) => return secure(StatusCode::SERVICE_UNAVAILABLE),
+    }
+    let enabled = crate::flow_public_pages::enabled();
+    let report = if enabled {
+        timeout_at(deadline, crate::flow_public_pages::report(&state.accounts)).await.ok().and_then(Result::ok)
+    } else { None };
+    let status = if report.is_some() || !enabled { StatusCode::OK } else { StatusCode::SERVICE_UNAVAILABLE };
+    secure((status, super::render::public_pages::page(report.as_ref(), enabled)))
+}
