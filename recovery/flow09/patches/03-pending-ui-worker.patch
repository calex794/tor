+use tor_recommendations::services::flow_signals::Evidence;
+use tor_search::domain::public_pages::PublicPageReport;
+
+pub(super) fn input(report: Option<&PublicPageReport>, enabled: bool) -> Evidence {
+    if !enabled { return Evidence::missing(false); }
+    let Some(report) = report else { return Evidence::missing(true); };
+    let expected = report.expected_targets();
+    let checked = report.checked_targets();
+    let lost = report.lost_targets();
+    Evidence {
+        enabled: true,
+        available: true,
+        current: (lost>0 || expected>0 && checked==expected).then_some(lost),
+        current_units: checked,
+        expected_units: expected.max(1),
+        ..Evidence::missing(true)
+    }
+}
